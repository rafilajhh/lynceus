# Lynceus container env file (for `docker run --env-file`). Copy it and fill in the key:
#   cp deploy/lynceus.env.example deploy/lynceus.env      (local; git-ignored)
#   sudo install -m 600 deploy/lynceus.env.example /etc/lynceus.env   (server)
# No quotes around values. NEVER commit the real key.
#
# Deliberately NOT set here: LYNCEUS_STORAGE_DIR, LYNCEUS_WEB_DIR,
# LYNCEUS_BENCHMARK_DIR, PORT. The image sets them (storage = the /data/runs volume).
VLLM_VLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLM_MODEL=MiniCPM-V-4.7-35B-A3B
LLM_MODEL=DeepSeek-V4-Flash
ASSIST_URL=https://developer.amd.com.cn/radeon/api/v1
ASSIST_MODEL=DeepSeek-V4-Flash
# Shift-report supplier explanations (unset = the assist role above).
# Optional: Gemma for this role (Google partner prize). It is NOT live-checked:
# in docs/research/token-factory-probe.md it replied with garbage to all 3
# Pythia prompts that carried a system message; the explain role now folds the
# system message into the user turn. To enable, uncomment both lines, open
# /shift-report with a flagged supplier and confirm the rows show
# explanation_source "model" and explanation_model is Gemma; anything
# off-contract falls back to the rule sentence (explanation_source "rule").
# EXPLAIN_URL=https://developer.amd.com.cn/radeon/api/v1
# EXPLAIN_MODEL=Gemma-4-31B-IT
LOCALISATION_MODE=box
VLLM_API_KEY=PASTE-THE-TEAM-KEY-HERE
# Hosted demo: fail closed (HTTP 503) when the live AI fails, instead of the offline stub.
# Exception: when the CPU detector can read the photo, the answer is a detector-only
# verdict (always escalate_human, provenance detector_only_degraded) instead of 503.
LYNCEUS_ALLOW_STUB_FALLBACK=0
# Vision models tried in order on VLLM_VLM_URL when VLM_MODEL fails (e.g. Token
# Factory "no available workers"); comma-separated, empty = none. List only
# image-capable models. Gemma-4-31B-IT has only a partial 20-image run
# (docs/research/gemma-vision-partial-2026-10-15.summary.json) and was withdrawn
# from the Token Factory catalog on 2026-10-15. Only HTTP error statuses and
# unparseable replies fall back; one time budget covers the whole chain.
VLM_FALLBACK_MODELS=
# A fallback model not listed here can never accept or reject a load on its
# own (either becomes escalate_human). Comma-separated.
VLM_BENCHMARKED_MODELS=MiniCPM-V-4.7-35B-A3B
# Reads per photo, merged by majority vote (1..4, default 3); run in parallel
# inside the same time budget.
VLM_VOTES=3
# CPU detector second opinion. The image already points DETECTOR_MODEL_PATH at the
# bundled model; uncomment with an EMPTY value to turn the detector off. It never
# rejects or accepts alone, it only holds a truck for a human. The thresholds were
# picked on a val split (RealWaste val + TACO val), not on gate photos:
# recalibrate them on gate photos.
#DETECTOR_MODEL_PATH=
DETECTOR_HARD_CONF=0.35
DETECTOR_LIGHT_CONF=0.05
# 1 = a glass/organic detection the vision model did not report holds the truck too.
DETECTOR_ESCALATE_LIGHT=1
# onnxruntime intra-op threads per detector run (at most 2 runs at once).
DETECTOR_THREADS=2
# The detector runs on the CPU (CPUExecutionProvider), the only provider.
DETECTOR_PROVIDERS=CPUExecutionProvider
# Console session auth (login page + guards on the console pages and the API).
# Leave LYNCEUS_ADMIN_USERNAME unset (or no password) = auth disabled, open demo.
# The SHA-256 hex digest takes precedence over the plaintext password.
#LYNCEUS_ADMIN_USERNAME=
#LYNCEUS_ADMIN_PASSWORD=
#LYNCEUS_ADMIN_PASSWORD_SHA256=
