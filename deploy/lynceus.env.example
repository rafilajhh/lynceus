# Lynceus container env — copy to deploy/lynceus.env and fill in the key.
#   docker run --env-file deploy/lynceus.env ...   (see Dockerfile header)
# No quotes around values. NEVER commit the real key.
# Full variable reference: README "Environment variables".

# --- AI endpoint (AMD Token Factory, OpenAI-compatible) -------------
VLLM_VLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_API_KEY=PASTE-THE-TEAM-KEY-HERE
VLM_MODEL=DeepSeek-V4-Flash-Vision-Exp
LLM_MODEL=DeepSeek-V4-Flash
ASSIST_URL=https://developer.amd.com.cn/radeon/api/v1
ASSIST_MODEL=DeepSeek-V4-Flash

# --- Console login (unset = open demo, no login page) ---------------
LYNCEUS_ADMIN_USERNAME=admin
LYNCEUS_ADMIN_PASSWORD=

# --- Behaviour -------------------------------------------------------
# Hosted demo: fail closed (503) when live AI fails (stub never shows).
LYNCEUS_ALLOW_STUB_FALLBACK=0
VLM_FALLBACK_MODELS=Gemma-4-31B-IT
VLM_VOTES=3
DETECTOR_ESCALATE_LIGHT=1
