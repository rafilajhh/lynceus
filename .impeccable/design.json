{
  "$schema": "https://schemas.impeccable.design/design.json",
  "name": "Lynceus",
  "version": "1.0.0",
  "description": "Industrial control-room register: graphite-dark ground, hairline 1px seams instead of shadows, one-step elevation, single amber accent reserved for state + signature, verdict green/amber/red only where they carry meaning. Tokens extracted from web/app/globals.css @theme block.",
  "source": {
    "css": "web/app/globals.css",
    "themeBlock": "@theme",
    "layout": "web/app/layout.tsx",
    "directionContract": ".impeccable/surface-briefs/web-app.md"
  },
  "colors": {
    "ground": {
      "value": "#0a0c10",
      "role": "page background, deepest tier"
    },
    "panel": {
      "value": "#0e1116",
      "role": "panels / cards / top bar"
    },
    "raised": {
      "value": "#161b23",
      "role": "raised surface inside a panel (panel-head, inputs, gate cells)"
    },
    "seam": {
      "value": "#1c2128",
      "role": "1px hairline borders, row separators"
    },
    "seamStrong": {
      "token": "--color-seam-strong",
      "value": "#2a323d",
      "role": "hovered seams, control borders, scrollbar thumb"
    },
    "ink": {
      "value": "#e8eaed",
      "role": "primary text"
    },
    "muted": {
      "value": "#9aa3ad",
      "role": "secondary text, labels"
    },
    "faint": {
      "value": "#7d8899",
      "role": "tertiary text, source lines (>=4.5:1 on panel/raised)"
    },
    "amber": {
      "value": "#f5a623",
      "role": "the ONE brand accent: state + signature only (focus, caret, selection tint, active filter, selected row marker, gate pulse, ESCALATE/REFUSED)"
    },
    "amberSoft": {
      "token": "--color-amber-soft",
      "value": "rgba(245, 166, 35, 0.16)",
      "role": "tint backgrounds (::selection, active filter chip, gate strip evaluating)"
    },
    "amberLine": {
      "token": "--color-amber-line",
      "value": "rgba(245, 166, 35, 0.45)",
      "role": "ring outer / dimmed amber border (default button hover)"
    },
    "verdictGreen": {
      "token": "--color-verdict-green",
      "value": "#2ecc71",
      "role": "ACCEPT verdict, passed gate, prevented-loss figure"
    },
    "verdictAmber": {
      "token": "--color-verdict-amber",
      "value": "#f5a623",
      "role": "ESCALATE verdict (shares the accent)"
    },
    "verdictRed": {
      "token": "--color-verdict-red",
      "value": "#e74c3c",
      "role": "REJECT verdict, failed gate, error states"
    },
    "greenDim": {
      "token": "--color-green-dim",
      "value": "rgba(46, 204, 113, 0.14)",
      "role": "verdict-green tint background (banner, badge, passed gate cell)"
    },
    "amberDim": {
      "token": "--color-amber-dim",
      "value": "rgba(245, 166, 35, 0.14)",
      "role": "verdict-amber tint background (banner, badge, REFUSED explainer)"
    },
    "redDim": {
      "token": "--color-red-dim",
      "value": "rgba(231, 76, 60, 0.14)",
      "role": "verdict-red tint background (banner, badge, failed gate cell, error panel)"
    },
    "dotOk": {
      "token": "--color-dot-ok",
      "value": "#2ecc71",
      "role": "status dot: service up / gate passed"
    },
    "dotWarn": {
      "token": "--color-dot-warn",
      "value": "#f5a623",
      "role": "status dot: probe pending / stub"
    },
    "dotDown": {
      "token": "--color-dot-down",
      "value": "#e74c3c",
      "role": "status dot: service down"
    },
    "dotIdle": {
      "token": "--color-dot-idle",
      "value": "#7d8899",
      "role": "status dot: un-lit gate light before resolve"
    }
  },
  "fonts": {
    "sans": {
      "family": "IBM Plex Sans",
      "stack": "var(--font-plex-sans), \"Segoe UI\", system-ui, sans-serif",
      "weights": ["400", "500", "600", "700"],
      "role": "UI typeface (body default, font-sans)"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "stack": "var(--font-plex-mono), ui-monospace, Consolas, monospace",
      "weights": ["400", "500", "600"],
      "role": "data/figures only (.figure utility, font-variant-numeric: tabular-nums)"
    },
    "base": {
      "fontSize": "15px",
      "lineHeight": "1.55",
      "smallcapsPattern": {
        "fontSize": "12px",
        "fontWeight": 700,
        "letterSpacing": "1.4px",
        "textTransform": "uppercase",
        "color": "--color-muted"
      }
    }
  },
  "radii": {
    "card": {
      "token": "--radius-card",
      "value": "14px",
      "role": "default card/panel radius"
    },
    "cardLg": {
      "token": "--radius-card-lg",
      "value": "16px",
      "role": "photo hero / large card"
    },
    "control": {
      "token": "--radius-control",
      "value": "6px",
      "role": "buttons, inputs — crisp machine feel"
    },
    "componentExceptions": {
      "verdictBanner": "10px",
      "gateStrip": "10px",
      "badgeChipDot": "9999px"
    }
  },
  "spacing": {
    "scale": "Tailwind v4 default spacing scale (utilities in components)",
    "used": {
      "panelHeadPadding": "12px 16px",
      "panelBodyPadding": "16px",
      "inputPadding": "8px 10px",
      "buttonPadding": "16px 8px",
      "buttonPaddingSm": "12px 6px",
      "buttonPaddingLg": "24px 10px",
      "tableCellPadding": "10px 16px",
      "main": "px-6 py-6 pb-14",
      "pageMaxWidth": "1320px",
      "workspaceGrid": "gap-5, lg:grid-cols-[5fr_7fr]",
      "landingHeroGrid": "lg:grid-cols-[1.15fr_0.85fr] gap-14"
    }
  },
  "motion": {
    "easeSmooth": {
      "token": "--ease-smooth",
      "value": "cubic-bezier(0.2, 0.6, 0.2, 1)"
    },
    "stagger": {
      "token": "--stagger",
      "value": "120ms",
      "role": "sequential gate-light snap (interlock gate strip)"
    },
    "gatePulse": {
      "keyframes": "0%,100% { opacity: 0.55 } 50% { opacity: 1 }",
      "duration": "1.1s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "role": "amber breathing while interlock evaluates"
    },
    "countUp": {
      "durationMs": 1400,
      "easing": "easeOutExpo (1 - 2^-10t)",
      "role": "impact counter / landing proof figures"
    },
    "reducedMotion": "prefers-reduced-motion: reduce → snap to final value (JS) + all animation/transition durations forced to 0.01ms (CSS)"
  },
  "surfaces": {
    "browser": {
      "selection": "background: --color-amber-soft; color: --color-ink",
      "scrollbar": "thin graphite: thumb --color-seam-strong (999px radius, 2px ground inset), track --color-ground, hover thumb --color-muted",
      "focusVisible": "outline: 2px solid --color-amber; outline-offset: 2px; border-radius: --radius-control",
      "caret": "--color-amber",
      "defaultBorder": "* { border-color: var(--color-seam) }"
    },
    "rules": [
      "no box-shadow on cards/panels — depth via graphite scale + hairline 1px seams only",
      "one-step elevation: panel (bg-panel) → raised (bg-raised); nothing higher",
      "amber accent reserved for state + signature",
      "verdict green/amber/red only where they carry meaning",
      "mono (IBM Plex Mono) only for data/measurement",
      "no gradient text, no glass, no hero-metric template, no emoji icons (SVG)"
    ]
  }
}
