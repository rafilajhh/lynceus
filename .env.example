# Lynceus backend configuration for LOCAL DEVELOPMENT — copy to backend/.env and adjust.
# (The localhost vLLM URLs below are dev defaults; they are not reachable from a container.)
# NEVER commit real keys.

VLLM_VLM_URL=http://localhost:8000/v1
VLLM_LLM_URL=http://localhost:8001/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Local dev only: the default is already ./runs, so leave this commented out.
# Do NOT feed this file to `docker run --env-file`: it would override the
# container's /data/runs volume path. Docker users: deploy/lynceus.env.example.
#LYNCEUS_STORAGE_DIR=./runs
AUDIT_FORMAT_VERSION=1

# Set to 0 to fail closed (HTTP 503) when the live AI endpoint fails,
# instead of falling back to the deterministic stub.
#LYNCEUS_ALLOW_STUB_FALLBACK=1

# Optional bearer key for the vLLM endpoints (leave empty for no auth header).
VLLM_API_KEY=

# Example block for a custom testing endpoint (single model serving both
# VLM and LLM roles).  Uncomment and adjust; NEVER put a real key here.
#VLLM_VLM_URL=https://your-testing-endpoint.example/v1
#VLLM_LLM_URL=https://your-testing-endpoint.example/v1
#VLM_MODEL=your-testing-model
#LLM_MODEL=your-testing-model
#VLLM_API_KEY=your-key-here

# AMD Token Factory (free shared endpoints on AMD GPUs, OpenAI-compatible).
# Get the team key at notebooks.amd.com/tokenfactory, then point all three
# roles (VLM, LLM, assist) at the same base URL. Model choice is measured in
# docs/research/token-factory-probe.md: MiniCPM-V localises hazards with
# boxes, DeepSeek-V4-Flash answers the assist contract; DeepSeek-V4.1-Flash
# timed out on images and Gemma-4-31B-IT failed the assist contract.
#VLLM_VLM_URL=https://developer.amd.com.cn/radeon/api/v1
#VLLM_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
#VLM_MODEL=MiniCPM-V-4.7-35B-A3B
#LLM_MODEL=DeepSeek-V4-Flash
#ASSIST_URL=https://developer.amd.com.cn/radeon/api/v1
#ASSIST_MODEL=DeepSeek-V4-Flash
#LOCALISATION_MODE=box
#VLLM_API_KEY=rc-your-team-key-here
# Hosted demo: fail closed (HTTP 503) instead of showing the offline stub.
#LYNCEUS_ALLOW_STUB_FALLBACK=0
