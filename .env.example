# Lynceus backend env — copy to backend/.env for local runs.
# Docker users: deploy/lynceus.env.example instead.
# Full variable reference: README "Environment variables". NEVER commit real keys.

# --- AI endpoint (AMD Token Factory, OpenAI-compatible) -------------
VLLM_VLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
VLLM_API_KEY=PASTE-THE-TEAM-KEY-HERE
VLM_MODEL=DeepSeek-V4-Flash-Vision-Exp
LLM_MODEL=DeepSeek-V4-Flash

# --- Console login (unset = open demo, no login page) ---------------
#LYNCEUS_ADMIN_USERNAME=admin
#LYNCEUS_ADMIN_PASSWORD=

# --- Behaviour -------------------------------------------------------
# 0 = fail closed (503) when live AI fails; 1 = deterministic stub.
#LYNCEUS_ALLOW_STUB_FALLBACK=1
# Vision fallback chain + majority-vote reads (see README).
#VLM_FALLBACK_MODELS=Gemma-4-31B-IT
#VLM_VOTES=3
