# Lynceus backend configuration for LOCAL DEVELOPMENT — copy to backend/.env and adjust.
# (The localhost vLLM URLs below are dev defaults; they are not reachable from a container.)
# NEVER commit real keys.

VLLM_VLM_URL=http://localhost:8000/v1
VLLM_LLM_URL=http://localhost:8001/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Local dev only: the default is already ./runs, so leave this commented out.
# Do NOT feed this file to `docker run --env-file`: it would override the
# container's /data/runs volume path. Docker users: deploy/lynceus.env.example.
#LYNCEUS_STORAGE_DIR=./runs

# Console session auth (login page + guards on /app, /inspections, /shift,
# /validation and the API). Unset username or password = auth disabled
# (open demo mode, every guard passes through). The SHA-256 hex digest of
# the password takes precedence over the plaintext value when both are set.
#LYNCEUS_ADMIN_USERNAME=
#LYNCEUS_ADMIN_PASSWORD=
#LYNCEUS_ADMIN_PASSWORD_SHA256=

# Set to 0 to fail closed (HTTP 503) when the live AI endpoint fails,
# instead of falling back to the deterministic stub.
#LYNCEUS_ALLOW_STUB_FALLBACK=1

# Optional bearer key for the vLLM endpoints (leave empty for no auth header).
VLLM_API_KEY=

# Example block for a custom testing endpoint (single model serving both
# VLM and LLM roles).  Uncomment and adjust; NEVER put a real key here.
#VLLM_VLM_URL=https://your-testing-endpoint.example/v1
#VLLM_LLM_URL=https://your-testing-endpoint.example/v1
#VLM_MODEL=your-testing-model
#LLM_MODEL=your-testing-model
#VLLM_API_KEY=your-key-here

# AMD Token Factory (free shared endpoints on AMD GPUs, OpenAI-compatible).
# Get the team key at notebooks.amd.com/tokenfactory, then point all three
# roles (VLM, LLM, assist) at the same base URL. Model choice is measured in
# docs/research/token-factory-probe.md: MiniCPM-V localises hazards with
# boxes, DeepSeek-V4-Flash answers the assist contract; DeepSeek-V4.1-Flash
# timed out on images and Gemma-4-31B-IT failed the assist contract.
#VLLM_VLM_URL=https://developer.amd.com.cn/radeon/api/v1
#VLLM_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
#VLM_MODEL=MiniCPM-V-4.7-35B-A3B
#LLM_MODEL=DeepSeek-V4-Flash
#ASSIST_URL=https://developer.amd.com.cn/radeon/api/v1
#ASSIST_MODEL=DeepSeek-V4-Flash
# Shift-report supplier explanations; unset = the assist role. Gemma is not
# live-checked for this role (it failed the assist contract in the probe);
# off-contract replies fall back to the rule sentence.
#EXPLAIN_URL=https://developer.amd.com.cn/radeon/api/v1
#EXPLAIN_MODEL=Gemma-4-31B-IT
#LOCALISATION_MODE=box
#VLLM_API_KEY=rc-your-team-key-here
# Hosted demo: fail closed (HTTP 503) instead of showing the offline stub.
#LYNCEUS_ALLOW_STUB_FALLBACK=0
# Vision-model fallback: comma-separated models tried in order on VLLM_VLM_URL
# when VLM_MODEL fails with an HTTP error status or an unparseable reply (an
# unreachable endpoint or a spent time budget ends the chain). Empty = none.
# The whole chain shares one time budget. The audit uncertainty names the
# models that failed and the one that answered. A fallback model outside
# VLM_BENCHMARKED_MODELS (default MiniCPM-V-4.7-35B-A3B) can never accept or
# reject a load on its own: either becomes escalate_human.
# List only image-capable models. Gemma-4-31B-IT has only a partial 20-image run
# (docs/research/gemma-vision-partial-2026-10-15.summary.json, 6 errors) and was
# withdrawn from the Token Factory catalog on 2026-10-15; no other catalog vision
# model passed the metal probe, so this stays empty until one does.
#VLM_FALLBACK_MODELS=
#VLM_BENCHMARKED_MODELS=MiniCPM-V-4.7-35B-A3B
# Reads per photo, merged by majority vote (1..4, default 3). They run in
# parallel inside the same time budget; any failed read fails that model.
#VLM_VOTES=3

# CPU detector second opinion (YOLO26s fine-tuned on RealWaste, ONNX, ~150 ms).
# Unset = the bundled backend/models/lynceus-yolo26s-realwaste.onnx; set it
# EMPTY to turn the detector off. Needs onnxruntime, numpy and Pillow.
# It never rejects or accepts on its own: a metal box at/above
# DETECTOR_HARD_CONF that the vision model did not confirm holds the truck for
# a human; so does a glass/organic box at/above DETECTOR_LIGHT_CONF while
# DETECTOR_ESCALATE_LIGHT=1. With LYNCEUS_ALLOW_STUB_FALLBACK=0 and the vision
# model down, a readable photo gets a detector-only verdict (always escalate)
# instead of HTTP 503. The thresholds were read off the 80-image RealWaste
# test set (no calibration split): recalibrate them on gate photos.
#DETECTOR_MODEL_PATH=
#DETECTOR_HARD_CONF=0.25
#DETECTOR_LIGHT_CONF=0.25
#DETECTOR_ESCALATE_LIGHT=1
# onnxruntime intra-op threads per detector run (at most 2 runs at once).
#DETECTOR_THREADS=2
# onnxruntime execution providers, comma-separated, in preference order; the
# CPU is always the fallback (a missing or failing GPU provider never turns
# the detector off). The result's runtime names the provider actually used.
# - default: CPUExecutionProvider (plain `onnxruntime`).
# - Windows + AMD Radeon: install `onnxruntime-directml` INSTEAD of
#   `onnxruntime` and set DETECTOR_PROVIDERS=DmlExecutionProvider
#   (Radeon 760M iGPU: p50 27.9 ms vs 262.7 ms on 2 CPU threads).
# - Linux + AMD Instinct/Radeon with ROCm: an onnxruntime build with
#   MIGraphXExecutionProvider or ROCMExecutionProvider, e.g.
#   DETECTOR_PROVIDERS=MIGraphXExecutionProvider,ROCMExecutionProvider
#DETECTOR_PROVIDERS=CPUExecutionProvider
# GPU index for DirectML / ROCm / MIGraphX (DirectML numbers adapters in
# DXGI order: on a laptop with an iGPU and a dGPU, check which is 0).
#DETECTOR_DEVICE_ID=0
