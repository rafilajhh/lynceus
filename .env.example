# ── App ─────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── AMD / ROCm inference endpoint ───
# vLLM endpoint serving an open model on AMD Developer Cloud
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=

# ── Ingestion ───────────────────────
SENSOR_DATA_PATH=./data/raw
MODEL_REGISTRY_PATH=./data/models

# ── Never commit real keys. Use .env ─
